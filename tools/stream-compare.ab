// Every file of a list through the chunked reader, against the whole-string reader:
//   stream-compare <file with one path per line>
import "../tests/support/compare.ab"
import "abla/fs"
import "abla/io"
import "abla/process"
import "abla/text"

fun main: int {
    val options = [XmlOptions(), XmlOptions(allowDtd = true), XmlOptions(allowDtd = true, namespaces = false)]
    var files = 0
    var compared = 0
    var failed = 0
    for (name in Path(processArgument(0)).readText().split("\n")) {
        if (name.size > 0) {
            val text = Path(name).readText()
            files = files + 1
            for (o in options) {
                for (size in [1, 3, 7, 4096]) {
                    compared = compared + 1
                    val difference = compareReaders(text, o, size)
                    if (difference != "") {
                        failed = failed + 1
                        eprintln("$name, pieces of $size: $difference")
                    }
                }
            }
        }
    }
    println("$files files, $compared comparisons, $failed differences")
    if (failed > 0) 1 else 0
}
