// Property: what the writer wrote, the parser reads back, for generated documents.
import "../src/xml.ab"
import "support/generate.ab"
import "abla/test"
import "../src/parse.ab"
import "../src/writer.ab"
import "../src/tree.ab"

private fun checkNamespaceClosure(): void {
    val original = xmlParse("<outer xmlns='urn:original' xmlns:p='urn:attr'><child p:id='1' id='2'><none xmlns=''/></child></outer>").document
    val detached = if (original != null) original.root.child("child") else null
    if (detached == null) {
        expect(false, "fixture has a detached subtree")
        return
    }
    val output = xmlWriter()
    output.startElement("host")
    output.namespace("", "urn:host")
    output.namespace("p", "urn:other")
    xmlWriteElement(output, detached)
    output.endElement()
    val result = output.finish()
    expect(result.succeeded, "detached subtree can be written")
    val reopened = xmlParse(result.text).document
    val child = if (reopened != null) reopened.root.child("child", "urn:original") else null
    if (child == null) {
        expect(false, "detached subtree kept its original namespace")
        return
    }
    expectEqual(child.attributeValue("id", "", "urn:attr"), "1", "inherited attribute prefix is restored")
    expectEqual(child.attributeValue("id"), "2", "unprefixed attribute stays outside the default namespace")
    expect(child.child("none", "") != null, "explicit default reset is preserved")
    val plain = xmlParse("<plain/>").document
    if (plain != null) {
        val underDefault = xmlWriter()
        underDefault.startElement("host")
        underDefault.namespace("", "urn:host")
        xmlWriteElement(underDefault, plain.root)
        underDefault.endElement()
        expectEqual(underDefault.finish().text, "<host xmlns=\"urn:host\"><plain xmlns=\"\"/></host>", "standalone no-namespace node resets the host default")
    }
    val raw = xmlParse("<plain/>", XmlOptions(namespaces = false)).document
    if (raw != null) {
        val legacy = xmlWriter()
        legacy.startElement("host")
        legacy.namespace("", "urn:host")
        xmlWriteElement(legacy, raw.root)
        legacy.endElement()
        expectEqual(legacy.finish().text, "<host xmlns=\"urn:host\"><plain/></host>", "raw namespace mode retains legacy behavior")
    }
    return
}

class XmlLiteralWriterHolder(val xml: XmlWriter)

private fun checkLiteralWriters(): void {
    val value = "<&\"\t\n\r"
    val nested = $xml <p:node xmlns:p="urn:n" p:attr={value}/>
    val tree = $xml <r xmlns="urn:r" a={value}><data>{value}</data>{node nested}</r>
    val viaTree = xmlWriter()
    xmlWriteElement(viaTree, tree)
    val expected = viaTree.finish()
    expect(expected.succeeded, "literal tree writes")
    val holder = XmlLiteralWriterHolder(xmlWriter())
    val actual = $xmlw(holder.xml) <r xmlns="urn:r" a={value}><data>{value}</data>{node nested}</r>
    val streamed = actual.finish()
    expect(streamed.succeeded, "literal writer writes into a field")
    expectEqual(streamed.text, expected.text, "literal writer matches literal tree")
    val parsed = xmlParse(streamed.text).document
    if (parsed != null) {
        expectEqual(parsed.root.attributeValue("a"), value, "dynamic attribute survives write and parse")
        expectEqual(parsed.root.childText("data", "urn:r"), value, "dynamic text survives write and parse")
    } else {
        expect(false, "written XML parses")
    }
    val host = xmlWriter()
    host.startElement("host")
    host.namespace("", "urn:host")
    $xmlw(host) <plain/>
    host.endElement()
    expectEqual(host.finish().text, "<host xmlns=\"urn:host\"><plain xmlns=\"\"/></host>", "streaming preserves empty expanded namespace")
    val fresh = $xmlw(xmlWriter()) <r/>
    expectEqual(fresh.finish().text, "<r/>", "fresh writer works")
    val raw = xmlParse("<raw/>", XmlOptions(namespaces = false)).document
    if (raw != null) {
        val rawNode = raw.root
        val assembled = $xml <r>{node rawNode}</r>
        val rejectedTree = xmlWriter()
        xmlWriteElement(rejectedTree, assembled)
        expectEqual(rejectedTree.finish().errorCode, "unresolved_namespace", "literal tree refuses raw node")
        val rejectedStream = $xmlw(xmlWriter()) <r>{node rawNode}</r>
        expectEqual(rejectedStream.finish().errorCode, "unresolved_namespace", "literal stream refuses raw node")
    } else {
        expect(false, "raw node fixture parses")
    }
    return
}

fun main: int {
    checkLiteralWriters()
    checkNamespaceClosure()
    var seed = 1
    while (seed <= 2000) {
        val generated = generateDocument(seed)
        if (!expect(generated.result.succeeded, "seed $seed writes: ${generated.result.errorCode} ${generated.result.errorMessage}")) return testsPassed()
        val parsed = xmlParse(generated.result.text)
        val problem = parsed.error
        if (problem != null) {
            expect(false, "seed $seed parses: ${problem.code} ${problem.message} at ${problem.line}:${problem.column}")
            return testsPassed()
        }
        val document = parsed.document
        if (document != null) {
            if (!expectEqual(describeTree(document.root), generated.expected, "seed $seed reads back")) return testsPassed()
            // Writing the tree again gives the same bytes when it holds the same text nodes:
            // and always means the same.
            val again = xmlWriter()
            xmlWriteDocument(again, document)
            val rewritten = again.finish()
            expect(rewritten.succeeded, "seed $seed rewrites")
            val reparsed = xmlParse(rewritten.text).document
            if (reparsed != null) {
                expectEqual(describeTree(reparsed.root), generated.expected, "seed $seed rewritten reads back")
                val third = xmlWriter()
                xmlWriteDocument(third, reparsed)
                expectEqual(third.finish().text, rewritten.text, "seed $seed writing is stable")
            } else {
                expect(false, "seed $seed reparses")
            }
        }
        expectEqual(generateDocument(seed).result.text, generated.result.text, "seed $seed is deterministic")
        seed = seed + 1
    }
    testsPassed()
}
