import "../src/xml.ab"
import "abla/test"
import "abla/text"

fun fails(result: XmlWriteResult, code: string, label: string): void {
    expect(!result.succeeded, "$label fails")
    expectEqual(result.errorCode, code, label)
    return
}

fun oneText(text: string): XmlWriteResult {
    val w = xmlWriter()
    w.startElement("a")
    w.text(text)
    w.endElement()
    w.finish()
}

fun main: int {
    val w = xmlWriter()
    w.declaration()
    w.startElement("a")
    w.namespace("", "urn:d")
    w.attribute("z", "1")
    w.namespace("p", "urn:p")
    w.attribute("p:b", "2")
    w.attribute("c", "<&>\"'\t\n\r")
    w.element("x", "<&>]]>\"'\t\n\r")
    w.element("empty")
    w.cdata("a]]>b<")
    w.comment(" note ")
    w.processingInstruction("go", "now")
    w.endElement()
    val r = w.finish()
    expect(r.succeeded, "document writes")
    expectEqual(r.text,
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<a xmlns=\"urn:d\" z=\"1\" xmlns:p=\"urn:p\" p:b=\"2\" c=\"&lt;&amp;&gt;&quot;'&#x9;&#xA;&#xD;\"><x>&lt;&amp;&gt;]]&gt;\"'\t\n&#xD;</x><empty/><![CDATA[a]]]]><![CDATA[>b<]]><!-- note --><?go now?></a>",
        "exact bytes and field order")

    val pretty = xmlWriter(XmlWriterOptions(indent = "  "))
    pretty.declaration("yes")
    pretty.comment("top")
    pretty.startElement("a")
    pretty.startElement("b")
    pretty.element("c", "text")
    pretty.startElement("mixed")
    pretty.text("t")
    pretty.element("i", "u")
    pretty.endElement()
    pretty.endElement()
    pretty.element("d")
    pretty.endElement()
    expectEqual(pretty.finish().text,
        "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<!--top-->\n<a>\n  <b>\n    <c>text</c>\n    <mixed>t<i>u</i></mixed>\n  </b>\n  <d/>\n</a>\n",
        "indentation leaves text alone")

    // Encodings
    val cp = xmlWriter(XmlWriterOptions(encoding = "Windows-1252"))
    cp.declaration()
    cp.startElement("café")
    cp.attribute("a", "€世")
    cp.text("é€世\u{1F600}")
    cp.endElement()
    expectEqual(cp.finish().text,
        "<?xml version=\"1.0\" encoding=\"Windows-1252\"?>\n<caf\xE9 a=\"\x80&#x4E16;\">\xE9\x80&#x4E16;&#x1F600;</caf\xE9>",
        "windows-1252 bytes and references")
    val ascii = xmlWriter(XmlWriterOptions(encoding = "US-ASCII"))
    ascii.startElement("a")
    ascii.text("é")
    ascii.endElement()
    expectEqual(ascii.finish().text, "<a>&#xE9;</a>", "ascii reference")
    val latin = xmlWriter(XmlWriterOptions(encoding = "ISO-8859-1"))
    latin.startElement("a")
    latin.text("é€")
    latin.endElement()
    expectEqual(latin.finish().text, "<a>\xE9&#x20AC;</a>", "latin-1 byte and reference")
    val lacks = xmlWriter(XmlWriterOptions(encoding = "US-ASCII"))
    lacks.startElement("café")
    lacks.endElement()
    fails(lacks.finish(), "unencodable_char", "name outside the encoding")
    val lacksComment = xmlWriter(XmlWriterOptions(encoding = "US-ASCII"))
    lacksComment.comment("é")
    fails(lacksComment.finish(), "unencodable_char", "comment outside the encoding")
    fails(xmlWriter(XmlWriterOptions(encoding = "EBCDIC")).finish(), "unsupported_encoding", "unknown encoding")
    fails(xmlWriter(XmlWriterOptions(encoding = "UTF-16")).finish(), "unsupported_encoding", "no UTF-16 output")
    fails(xmlWriter(XmlWriterOptions(indent = "x")).finish(), "invalid_indent", "indent must be whitespace")

    // Characters
    fails(oneText("a\x01b"), "invalid_char", "control character")
    fails(oneText("\xFF"), "invalid_char", "invalid UTF-8")
    fails(oneText("\xED\xA0\x80"), "invalid_char", "surrogate")
    fails(oneText("\xEF\xBF\xBE"), "invalid_char", "U+FFFE")
    expect(oneText("\u{10FFFF}").succeeded, "astral character")

    // Structure
    fails(xmlWriter().finish(), "no_root", "no root")
    val open = xmlWriter()
    open.startElement("a")
    fails(open.finish(), "unbalanced", "unclosed element")
    val under = xmlWriter()
    under.endElement()
    fails(under.finish(), "unbalanced", "extra end")
    val two = xmlWriter()
    two.element("a")
    two.element("b")
    fails(two.finish(), "multiple_roots", "two roots")
    val out = xmlWriter()
    out.text("x")
    fails(out.finish(), "text_outside_root", "text outside")
    val decl = xmlWriter()
    decl.element("a")
    decl.declaration()
    fails(decl.finish(), "misplaced_declaration", "late declaration")
    val sa = xmlWriter()
    sa.declaration("maybe")
    fails(sa.finish(), "invalid_standalone", "bad standalone")
    val late = xmlWriter()
    late.startElement("a")
    late.text("x")
    late.attribute("b", "c")
    fails(late.finish(), "misplaced_attribute", "attribute after content")
    val done = xmlWriter()
    done.element("a")
    expect(done.finish().succeeded, "first finish")
    done.comment("x")
    fails(done.finish(), "finished", "write after finish")

    // Names
    for (bad in ["", "1a", "a b", "a:b:c", ":a", "a:", "a:1", "<a"]) {
        val n = xmlWriter()
        n.startElement(bad)
        fails(n.finish(), "invalid_name", "element name [$bad]")
        val at = xmlWriter()
        at.startElement("a")
        at.attribute(bad, "v")
        fails(at.finish(), "invalid_name", "attribute name [$bad]")
    }
    val xmlPi = xmlWriter()
    xmlPi.processingInstruction("XmL", "a")
    fails(xmlPi.finish(), "invalid_name", "reserved PI target")
    val piEnd = xmlWriter()
    piEnd.processingInstruction("a", "?>")
    fails(piEnd.finish(), "invalid_processing_instruction", "PI end in data")
    for (bad in ["--", "a--b", "a-"]) {
        val c = xmlWriter()
        c.comment(bad)
        fails(c.finish(), "invalid_comment", "comment [$bad]")
    }

    // Attributes and namespaces
    val dup = xmlWriter()
    dup.startElement("a")
    dup.attribute("b", "1")
    dup.attribute("b", "2")
    dup.endElement()
    fails(dup.finish(), "duplicate_attribute", "duplicate attribute")
    val expanded = xmlWriter()
    expanded.startElement("a")
    expanded.namespace("p", "urn:x")
    expanded.namespace("q", "urn:x")
    expanded.attribute("p:b", "1")
    expanded.attribute("q:b", "2")
    expanded.endElement()
    fails(expanded.finish(), "duplicate_attribute", "same expanded name")
    val undeclared = xmlWriter()
    undeclared.startElement("p:a")
    undeclared.endElement()
    fails(undeclared.finish(), "undeclared_prefix", "undeclared element prefix")
    val undeclaredAttr = xmlWriter()
    undeclaredAttr.startElement("a")
    undeclaredAttr.attribute("p:b", "1")
    undeclaredAttr.endElement()
    fails(undeclaredAttr.finish(), "undeclared_prefix", "undeclared attribute prefix")
    val scope = xmlWriter()
    scope.startElement("a")
    scope.startElement("b")
    scope.namespace("p", "urn:p")
    scope.endElement()
    scope.startElement("p:c")
    scope.endElement()
    scope.endElement()
    fails(scope.finish(), "undeclared_prefix", "prefix out of scope")
    val xmlns = xmlWriter()
    xmlns.startElement("a")
    xmlns.attribute("xmlns:p", "urn:p")
    fails(xmlns.finish(), "misplaced_namespace", "xmlns through attribute")
    val implicitXml = xmlWriter()
    implicitXml.startElement("a")
    implicitXml.attribute("xml:lang", "pt")
    implicitXml.endElement()
    expectEqual(implicitXml.finish().text, "<a xml:lang=\"pt\"/>", "xml prefix needs no declaration")
    val nsBad = xmlWriter()
    nsBad.startElement("a")
    nsBad.namespace("xmlns", "urn:x")
    fails(nsBad.finish(), "reserved_namespace_prefix", "xmlns prefix")
    val nsBad2 = xmlWriter()
    nsBad2.startElement("a")
    nsBad2.namespace("p", "")
    fails(nsBad2.finish(), "empty_namespace_prefix", "empty prefixed namespace")
    val nsBad3 = xmlWriter()
    nsBad3.startElement("a")
    nsBad3.namespace("p", xmlNamespaceXml)
    fails(nsBad3.finish(), "reserved_namespace_uri", "xml namespace")
    val undeclareDefault = xmlWriter()
    undeclareDefault.startElement("a")
    undeclareDefault.namespace("", "urn:d")
    undeclareDefault.startElement("b")
    undeclareDefault.namespace("", "")
    undeclareDefault.endElement()
    undeclareDefault.endElement()
    expectEqual(undeclareDefault.finish().text, "<a xmlns=\"urn:d\"><b xmlns=\"\"/></a>", "default namespace can be undone")
    testsPassed()
}
