// Encodings. Everything inside the library is UTF-8; these convert at the edges.
import "abla/bytes"
import "abla/text"
import "chars.ab"

val xmlEncodingUtf8 = 0
val xmlEncodingAscii = 1
val xmlEncodingLatin1 = 2
val xmlEncodingWindows1252 = 3
val xmlEncodingUtf16 = 4
val xmlEncodingUnknown = -1

// The encoding a declared name means, ignoring case (names are from the IANA
// registry, with their common aliases).
fun xmlEncodingFromName(name: string): int {
    val folded = name.uppercase()
    when (folded) {
        "UTF-8", "UTF8" -> xmlEncodingUtf8
        "US-ASCII", "ASCII" -> xmlEncodingAscii
        "ISO-8859-1", "ISO_8859-1", "LATIN1", "LATIN-1" -> xmlEncodingLatin1
        "WINDOWS-1252", "CP1252" -> xmlEncodingWindows1252
        "UTF-16" -> xmlEncodingUtf16
        else -> xmlEncodingUnknown
    }
}

// [81] EncName
fun xmlEncodingNameValid(name: string): bool {
    if (name.size == 0) return false
    val first = name[0]
    if (!((first >= 97 && first <= 122) || (first >= 65 && first <= 90))) return false
    var i = 1
    while (i < name.size) {
        val b = name[i]
        if (!((b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) ||
            b == 46 || b == 95 || b == 45)) return false
        i = i + 1
    }
    true
}

// Windows-1252 bytes 0x80 to 0x9F. A 0 is a byte the code page leaves undefined.
private fun xmlWindows1252High(byte: int): int = when (byte) {
    0x80 -> 0x20AC
    0x82 -> 0x201A
    0x83 -> 0x0192
    0x84 -> 0x201E
    0x85 -> 0x2026
    0x86 -> 0x2020
    0x87 -> 0x2021
    0x88 -> 0x02C6
    0x89 -> 0x2030
    0x8A -> 0x0160
    0x8B -> 0x2039
    0x8C -> 0x0152
    0x8E -> 0x017D
    0x91 -> 0x2018
    0x92 -> 0x2019
    0x93 -> 0x201C
    0x94 -> 0x201D
    0x95 -> 0x2022
    0x96 -> 0x2013
    0x97 -> 0x2014
    0x98 -> 0x02DC
    0x99 -> 0x2122
    0x9A -> 0x0161
    0x9B -> 0x203A
    0x9C -> 0x0153
    0x9E -> 0x017E
    0x9F -> 0x0178
    else -> 0
}

// The byte encoding a code point in a single-byte encoding, or -1 when the
// encoding can't represent it.
fun xmlEncodeSingleByte(cp: int, encoding: int): int {
    if (cp < 0x80) return cp
    if (encoding == xmlEncodingLatin1) return if (cp <= 0xFF) cp else -1
    if (encoding == xmlEncodingWindows1252) {
        if (cp >= 0xA0 && cp <= 0xFF) return cp
        var byte = 0x80
        while (byte <= 0x9F) {
            if (xmlWindows1252High(byte) == cp) return byte
            byte = byte + 1
        }
    }
    -1
}

class XmlDecoded(
    val text: string,
    val errorCode: string,
    val errorOffset: int,
    // How many bytes before `text` the source has: a skipped byte order mark.
    val bias: int
)

private fun xmlDecodeSingleByte(source: string, encoding: int): XmlDecoded {
    var i = 0
    while (i < source.size && source[i] < 0x80) i = i + 1
    if (i == source.size) return XmlDecoded(source, "", 0, 0)
    if (encoding == xmlEncodingAscii) {
        return XmlDecoded("", "invalid_encoding", i, 0)
    }
    val out = byteBuffer()
    out.appendText(source.slice(0, i))
    while (i < source.size) {
        val b = source[i]
        if (b < 0x80) {
            out.appendByteValue(b)
        } else if (encoding == xmlEncodingWindows1252 && b <= 0x9F) {
            val cp = xmlWindows1252High(b)
            if (cp == 0) return XmlDecoded("", "invalid_encoding", i, 0)
            out.appendText(utf8Encode(cp))
        } else {
            out.appendByteValue(0xC0 | (b >> 6))
            out.appendByteValue(0x80 | (b & 0x3F))
        }
        i = i + 1
    }
    XmlDecoded(out.toText(), "", 0, 0)
}

private fun xmlDecodeUtf16(source: string, bigEndian: bool): XmlDecoded {
    val high = if (bigEndian) 0 else 1
    val low = 1 - high
    val out = byteBuffer()
    var i = 2
    if (source.size % 2 != 0) {
        return XmlDecoded("", "invalid_encoding", source.size - 1, 0)
    }
    while (i < source.size) {
        val unit = (source[i + high] << 8) | source[i + low]
        i = i + 2
        var cp = unit
        if (unit >= 0xD800 && unit <= 0xDBFF) {
            if (i >= source.size) {
                return XmlDecoded("", "invalid_encoding", i - 2, 0)
            }
            val next = (source[i + high] << 8) | source[i + low]
            if (next < 0xDC00 || next > 0xDFFF) {
                return XmlDecoded("", "invalid_encoding", i - 2, 0)
            }
            cp = 0x10000 + ((unit - 0xD800) << 10) + (next - 0xDC00)
            i = i + 2
        } else if (unit >= 0xDC00 && unit <= 0xDFFF) {
            return XmlDecoded("", "invalid_encoding", i - 2, 0)
        }
        if (cp < 0x80) {
            out.appendByteValue(cp)
        } else {
            out.appendText(utf8Encode(cp))
        }
    }
    XmlDecoded(out.toText(), "", 0, 0)
}

// The value of the encoding pseudo-attribute of an XML declaration at the start
// of ASCII-compatible text, or "" when there is none. The declaration's grammar
// is checked later, by the parser, on the decoded text.
private fun xmlSniffDeclaredEncoding(source: string): string {
    if (!source.startsWith("<?xml") || source.size < 6 ||
        !xmlIsSpace(source[5])) return ""
    val close = source.indexOf("?>")
    if (close < 0) return ""
    val at = source.slice(0, close).indexOf("encoding")
    if (at < 0) return ""
    var i = at + 8
    while (i < close && xmlIsSpace(source[i])) i = i + 1
    if (i >= close || source[i] != 61) return ""
    i = i + 1
    while (i < close && xmlIsSpace(source[i])) i = i + 1
    if (i >= close || (source[i] != 34 && source[i] != 39)) return ""
    val end = source.indexOf(if (source[i] == 34) "\"" else "'", i + 1)
    if (end < 0 || end > close) return ""
    source.slice(i + 1, end)
}

// Decodes a document's bytes to UTF-8 per XML 1.0 section 4.3.3 and appendix F:
// a byte order mark decides first, then the XML declaration, then UTF-8.
fun xmlDecodeSource(source: string): XmlDecoded {
    if (source.size >= 2 && ((source[0] == 0xFF && source[1] == 0xFE) ||
        (source[0] == 0xFE && source[1] == 0xFF))) {
        val decoded = xmlDecodeUtf16(source, source[0] == 0xFE)
        if (decoded.errorCode.size > 0) return decoded
        val declared = xmlSniffDeclaredEncoding(decoded.text)
        if (declared.size > 0 && xmlEncodingFromName(declared) != xmlEncodingUtf16) {
            return XmlDecoded("", "encoding_mismatch", 0, 0)
        }
        return decoded
    }
    var bias = 0
    var body = source
    if (source.size >= 3 && source[0] == 0xEF && source[1] == 0xBB &&
        source[2] == 0xBF) {
        bias = 3
        body = source.slice(3, source.size)
    }
    val declared = xmlSniffDeclaredEncoding(body)
    // A malformed name is the parser's to report, as a malformed declaration.
    if (declared.size == 0 || !xmlEncodingNameValid(declared)) return XmlDecoded(body, "", 0, bias)
    val encoding = xmlEncodingFromName(declared)
    if (encoding == xmlEncodingUnknown) {
        return XmlDecoded("", "unsupported_encoding", 0, bias)
    }
    // UTF-16 needs a byte order mark, and a UTF-8 mark rules everything else out.
    if (encoding == xmlEncodingUtf16 ||
        (bias > 0 && encoding != xmlEncodingUtf8)) {
        return XmlDecoded("", "encoding_mismatch", 0, bias)
    }
    if (encoding == xmlEncodingUtf8) return XmlDecoded(body, "", 0, bias)
    xmlDecodeSingleByte(body, encoding)
}

// Where a chunked reader gets a document's bytes from.
interface XmlSource {
    // Up to `maximum` bytes, in any encoding the document declares, split anywhere;
    // "" at the end of the document or after a failure.
    fun read(maximum: int): string
    // Why reading stopped, when it wasn't the end of the document.
    fun failure(): string = ""
    // Called once the reader has finished with the source, even after an error.
    fun close(): bool = true
}

// A string as a source, a piece at a time.
class XmlStringSource(val text: string, var at: int = 0, val pieceBytes: int = 65536) : XmlSource {
    fun read(maximum: int): string {
        val wanted = if (maximum < pieceBytes) maximum else pieceBytes
        val end = if (at + wanted > text.size) text.size else at + wanted
        val piece = text.slice(at, end)
        at = end
        piece
    }
}

fun xmlStringSource(text: string, pieceBytes: int = 65536): XmlStringSource =
    XmlStringSource(text, 0, pieceBytes)

private val MODE_UTF8 = 0
private val MODE_SINGLE = 1
private val MODE_UTF16 = 2

// The start of a document decides how much more is needed to sniff its declaration.
private fun xmlDeclarationIncomplete(text: string, limit: int): bool {
    if (text.size < 6) return "<?xml".startsWith(text) || text.startsWith("<?xml")
    text.startsWith("<?xml") && xmlIsSpace(text[5]) && text.indexOf("?>") < 0 && text.size < limit
}

// xmlDecodeSource for a document arriving in pieces: UTF-8 text that is valid so far,
// however the bytes were split. It stops at the first problem, after giving what came
// before it, and holds at most one piece plus the bytes of one split character.
class XmlChunkDecoder(
    val source: XmlSource,
    val maxBytes: int,
    val maxHead: int,
    val pieceBytes: int,
    var mode: int = 0,
    var encoding: int = 0,
    var bigEndian: bool = false,
    var bias: int = 0,
    var carry: string = "",
    var rawBytes: int = 0,
    var ended: bool = false,
    var done: bool = false,
    var errorCode: string = "",
    var errorMessage: string = ""
) {
    fun stop(code: string, message: string): void {
        if (errorCode.size == 0) {
            errorCode = code
            errorMessage = message
        }
        done = true
        return
    }

    fun pull(): string {
        if (ended || done) return ""
        val piece = source.read(pieceBytes)
        if (piece.size == 0) {
            val why = source.failure()
            if (why.size > 0) stop("source_failed", why) else ended = true
            return ""
        }
        rawBytes = rawBytes + piece.size
        if (rawBytes > maxBytes) {
            stop("too_large", "the document is larger than $maxBytes bytes")
            return ""
        }
        piece
    }

    fun gather(first: string): string {
        val text = byteBuffer()
        text.appendText(first)
        var joined = first
        while (!ended && !done && xmlDeclarationIncomplete(joined, maxHead)) {
            text.appendText(pull())
            joined = text.toText()
        }
        joined
    }

    // Everything that arrives before the first next(): what the byte order mark and
    // the declaration say, as xmlDecodeSource decides it, and the text so far.
    fun start(): string {
        val mark = byteBuffer()
        while (!ended && !done && mark.size() < 3) mark.appendText(pull())
        val head = mark.toText()
        if (done) return ""
        if (head.size >= 2 && ((head[0] == 0xFF && head[1] == 0xFE) || (head[0] == 0xFE && head[1] == 0xFF))) {
            mode = MODE_UTF16
            bigEndian = head[0] == 0xFE
            var text = convert(head.slice(2, head.size))
            while (!ended && !done && xmlDeclarationIncomplete(text, maxHead)) {
                text = text + convert(pull())
            }
            if (ended && !done) text = text + convert("")
            if (done && errorCode.size > 0) return ""
            val declared = xmlSniffDeclaredEncoding(text)
            if (declared.size > 0 && xmlEncodingFromName(declared) != xmlEncodingUtf16) {
                stop("encoding_mismatch", "the byte order mark and the declared encoding disagree")
                return ""
            }
            return checked(text)
        }
        var body = head
        if (head.size >= 3 && head[0] == 0xEF && head[1] == 0xBB && head[2] == 0xBF) {
            bias = 3
            body = head.slice(3, head.size)
        }
        body = gather(body)
        if (done) return ""
        val declared = xmlSniffDeclaredEncoding(body)
        if (declared.size > 0 && xmlEncodingNameValid(declared)) {
            encoding = xmlEncodingFromName(declared)
            if (encoding == xmlEncodingUnknown) {
                stop("unsupported_encoding", "this parser can't read the declared encoding")
                return ""
            }
            if (encoding == xmlEncodingUtf16 || (bias > 0 && encoding != xmlEncodingUtf8)) {
                stop("encoding_mismatch", "the byte order mark and the declared encoding disagree")
                return ""
            }
            if (encoding != xmlEncodingUtf8) mode = MODE_SINGLE
        }
        checked(convert(body))
    }

    // The next piece of text, "" at the end of what can be given.
    fun next(): string {
        while (!done) {
            val piece = pull()
            if (done) return ""
            val text = checked(convert(piece))
            if (ended) done = true
            if (text.size > 0) return text
        }
        ""
    }

    // Stops at a character XML forbids, keeping the text before it.
    fun checked(text: string): string {
        val invalid = xmlFirstInvalidChar(text)
        if (invalid < 0) return text
        stop("invalid_char", "invalid UTF-8 or a character XML forbids")
        text.slice(0, invalid)
    }

    // Whole characters out of the bytes so far; the rest waits for the next piece.
    fun convert(raw: string): string {
        if (mode == MODE_SINGLE) {
            val decoded = xmlDecodeSingleByte(raw, encoding)
            if (decoded.errorCode.size == 0) return decoded.text
            stop(decoded.errorCode, "the bytes aren't valid in the declared encoding")
            return xmlDecodeSingleByte(raw.slice(0, decoded.errorOffset), encoding).text
        }
        val joined = if (carry.size > 0) carry + raw else raw
        carry = ""
        if (mode == MODE_UTF8) {
            if (ended) return joined
            var keep = joined.size
            var back = 1
            while (back <= 3 && back <= joined.size) {
                val b = joined[joined.size - back]
                if (b >= 0xC0) {
                    if (xmlUtf8Size(b) > back) keep = joined.size - back
                    break
                }
                if (b < 0x80) break
                back = back + 1
            }
            if (keep == joined.size) return joined
            carry = joined.slice(keep, joined.size)
            return joined.slice(0, keep)
        }
        var usable = joined.size - joined.size % 2
        if (ended && usable != joined.size) {
            stop("invalid_encoding", "the bytes aren't valid in the declared encoding")
            return ""
        }
        if (!ended && usable >= 2) {
            val top = if (bigEndian) joined[usable - 2] else joined[usable - 1]
            if (top >= 0xD8 && top <= 0xDB) usable = usable - 2
        }
        carry = joined.slice(usable, joined.size)
        if (usable == 0) return ""
        val decoded = xmlDecodeUtf16("\x00\x00" + joined.slice(0, usable), bigEndian)
        if (decoded.errorCode.size > 0) {
            stop(decoded.errorCode, "the bytes aren't valid in the declared encoding")
            return ""
        }
        decoded.text
    }
}

// The decoder of a reader over a whole string, which never asks it for anything.
fun xmlNoDecoder(): XmlChunkDecoder = XmlChunkDecoder(xmlStringSource(""), 0, 0, 0)
