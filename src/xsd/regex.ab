// XML Schema regular expressions (XSD 1.1 Part 2, appendix G), compiled to a program
// that a Pike machine runs in time linear in the input: a pattern from a schema can't make
// a long value take long, whatever it holds. Patterns are anchored at both ends, as
// XSD says. Unsupported, and an error when the schema is loaded: \d, \w and \p{...},
// which need Unicode's tables, and their complements.
import "abla/text"
import "../chars.ab"

// Instructions.
private val OP_CHAR = 0
private val OP_CLASS = 1
private val OP_SPLIT = 2
private val OP_JUMP = 3
private val OP_MATCH = 4

// Class items that aren't ranges.
private val SET_NAME_START = 1
private val SET_NAME_CHAR = 2

// A character class: `negated`, then the union of `ranges` (pairs, low and high
// inclusive), `sets` and the classes `classes` names, less `subtract`'s.
class XsdCharClass(
    val negated: bool,
    val ranges: array<int>,
    val sets: array<int>,
    val classes: array<int>,
    val subtract: int
)

// A compiled pattern: `ops`, with `a` and `b` their operands. `error` says why it
// couldn't be compiled, "" when it could.
class XsdRegex(
    val source: string,
    val ops: array<int>,
    val a: array<int>,
    val b: array<int>,
    val classes: array<XsdCharClass>,
    val error: string
) {
    fun matches(text: string): bool = xsdRegexMatches(this, text)
}

sealed interface XsdRegexNode
class XsdRegexChar(val cp: int) : XsdRegexNode
class XsdRegexClass(val index: int) : XsdRegexNode
class XsdRegexSequence(val items: array<XsdRegexNode>) : XsdRegexNode
class XsdRegexChoice(val options: array<XsdRegexNode>) : XsdRegexNode
// `max` -1 is unbounded.
class XsdRegexRepeat(val item: XsdRegexNode, val min: int, val max: int) : XsdRegexNode

// The most instructions a pattern may compile to, counted repeats included.
val xsdRegexMaxProgram = 65536

class XsdRegexParser(
    val cps: array<int>,
    var pos: int,
    val classes: array<XsdCharClass>,
    var error: string = ""
) {
    fun fail(message: string): XsdRegexNode {
        if (error == "") error = "$message at character ${pos + 1}"
        XsdRegexSequence([])
    }

    fun atEnd(): bool = pos >= cps.size
    fun peek(): int = if (pos < cps.size) cps[pos] else -1

    // regExp ::= branch ( '|' branch )*
    fun regExp(): XsdRegexNode {
        val options: array<XsdRegexNode> = [branch()]
        while (error == "" && peek() == 124) {
            pos = pos + 1
            options.append(branch())
        }
        if (options.size == 1) options[0] else XsdRegexChoice(options)
    }

    // branch ::= piece*
    fun branch(): XsdRegexNode {
        val items: array<XsdRegexNode> = []
        while (error == "" && !atEnd() && peek() != 124 && peek() != 41) items.append(piece())
        XsdRegexSequence(items)
    }

    // piece ::= atom quantifier?
    fun piece(): XsdRegexNode {
        val item = atom()
        if (error != "") return item
        val c = peek()
        if (c == 63) { pos = pos + 1; return XsdRegexRepeat(item, 0, 1) }
        if (c == 42) { pos = pos + 1; return XsdRegexRepeat(item, 0, -1) }
        if (c == 43) { pos = pos + 1; return XsdRegexRepeat(item, 1, -1) }
        if (c != 123) return item
        pos = pos + 1
        val min = number()
        if (min < 0) return fail("a quantifier needs a number")
        var max = min
        if (peek() == 44) {
            pos = pos + 1
            max = if (peek() == 125) -1 else number()
            if (max == -2) return fail("a quantifier's bound is not a number")
        }
        if (peek() != 125) return fail("a quantifier needs }")
        pos = pos + 1
        if (max >= 0 && max < min) return fail("a quantifier's maximum is below its minimum")
        XsdRegexRepeat(item, min, max)
    }

    // Digits, or -1 if none (-2 where one was needed by the caller).
    fun number(): int {
        var value = 0
        var digits = 0
        while (!atEnd() && peek() >= 48 && peek() <= 57) {
            value = value * 10 + (peek() - 48)
            if (value > 100000) {
                fail("a quantifier over 100000")
                return -1
            }
            digits = digits + 1
            pos = pos + 1
        }
        if (digits == 0) -2 else value
    }

    // atom ::= NormalChar | charClass | '(' regExp ')'
    fun atom(): XsdRegexNode {
        val c = peek()
        if (c == 40) {
            pos = pos + 1
            val inner = regExp()
            if (error != "") return inner
            if (peek() != 41) return fail("a group needs )")
            pos = pos + 1
            return inner
        }
        if (c == 91) return XsdRegexClass(classExpression())
        if (c == 92) return escape(false)
        if (c == 46) {
            pos = pos + 1
            // Anything but a line feed or carriage return.
            return XsdRegexClass(addClass(XsdCharClass(true, [10, 10, 13, 13], [], [], -1)))
        }
        if (c == 63 || c == 42 || c == 43 || c == 123 || c == 125 || c == 41 || c == 93) {
            return fail("unexpected ${utf8Encode(c)}")
        }
        pos = pos + 1
        XsdRegexChar(c)
    }

    fun addClass(cls: XsdCharClass): int {
        classes.append(cls)
        classes.size - 1
    }

    // After a backslash: a single character escape as a char, or a class escape as a class.
    // `inClass` allows the escapes only a class has.
    fun escape(inClass: bool): XsdRegexNode {
        pos = pos + 1
        if (atEnd()) return fail("a pattern can't end in \\")
        val c = peek()
        pos = pos + 1
        when (c) {
            110 -> return XsdRegexChar(10)
            114 -> return XsdRegexChar(13)
            116 -> return XsdRegexChar(9)
            92, 124, 46, 63, 42, 43, 40, 41, 123, 125, 45, 91, 93, 94 -> return XsdRegexChar(c)
            115 -> return XsdRegexClass(addClass(XsdCharClass(false, [9, 10, 13, 13, 32, 32], [], [], -1)))
            83 -> return XsdRegexClass(addClass(XsdCharClass(true, [9, 10, 13, 13, 32, 32], [], [], -1)))
            105 -> return XsdRegexClass(addClass(XsdCharClass(false, [], [SET_NAME_START], [], -1)))
            73 -> return XsdRegexClass(addClass(XsdCharClass(true, [], [SET_NAME_START], [], -1)))
            99 -> return XsdRegexClass(addClass(XsdCharClass(false, [], [SET_NAME_CHAR], [], -1)))
            67 -> return XsdRegexClass(addClass(XsdCharClass(true, [], [SET_NAME_CHAR], [], -1)))
            else -> {}
        }
        if (c == 100 || c == 68 || c == 119 || c == 87 || c == 112 || c == 80) {
            pos = pos - 1
            return fail("\\${utf8Encode(c)} needs Unicode's character tables, which this validator doesn't have")
        }
        pos = pos - 1
        fail("unknown escape \\${utf8Encode(c)}")
    }

    // charClassExpr ::= '[' '^'? charGroup ( '-' charClassExpr )? ']'
    fun classExpression(): int {
        pos = pos + 1
        var negated = false
        if (peek() == 94) {
            negated = true
            pos = pos + 1
        }
        val ranges: array<int> = []
        val sets: array<int> = []
        val included: array<int> = []
        var subtract = -1
        var first = true
        while (error == "") {
            if (atEnd()) {
                fail("a class needs ]")
                return addClass(XsdCharClass(false, [], [], [], -1))
            }
            val c = peek()
            if (c == 93 && !first) {
                pos = pos + 1
                break
            }
            if (c == 45 && !first && pos + 1 < cps.size && cps[pos + 1] == 91) {
                pos = pos + 1
                subtract = classExpression()
                if (peek() != 93) {
                    fail("a subtraction ends its class")
                    break
                }
                pos = pos + 1
                break
            }
            first = false
            var low = -1
            if (c == 92) {
                val escaped = escape(true)
                when (escaped) {
                    is XsdRegexChar -> low = escaped.cp
                    is XsdRegexClass -> included.append(escaped.index)
                    else -> {}
                }
                if (low < 0) continue
            } else if (c == 91) {
                fail("[ must be escaped in a class")
                break
            } else {
                low = c
                pos = pos + 1
            }
            // A range, unless the hyphen ends the class or starts a subtraction.
            if (peek() == 45 && pos + 1 < cps.size && cps[pos + 1] != 93 && cps[pos + 1] != 91) {
                pos = pos + 1
                var high = peek()
                if (high == 92) {
                    val escaped = escape(true)
                    high = -1
                    when (escaped) {
                        is XsdRegexChar -> high = escaped.cp
                        else -> {}
                    }
                    if (high < 0) {
                        fail("a range ends in a single character")
                        break
                    }
                } else {
                    pos = pos + 1
                }
                if (high < low) {
                    fail("a range's end is before its start")
                    break
                }
                ranges.append(low)
                ranges.append(high)
            } else {
                ranges.append(low)
                ranges.append(low)
            }
        }
        addClass(XsdCharClass(negated, ranges, sets, included, subtract))
    }
}

fun xsdClassContains(classes: array<XsdCharClass>, index: int, cp: int): bool {
    val cls = classes[index]
    var inside = false
    var i = 0
    while (i < cls.ranges.size) {
        if (cp >= cls.ranges[i] && cp <= cls.ranges[i + 1]) {
            inside = true
            break
        }
        i = i + 2
    }
    if (!inside) {
        for (set in cls.sets) {
            if ((set == SET_NAME_START && xmlIsNameStart(cp)) || (set == SET_NAME_CHAR && xmlIsNameChar(cp))) {
                inside = true
                break
            }
        }
    }
    if (!inside) {
        for (other in cls.classes) {
            if (xsdClassContains(classes, other, cp)) {
                inside = true
                break
            }
        }
    }
    if (cls.negated) inside = !inside
    if (inside && cls.subtract >= 0 && xsdClassContains(classes, cls.subtract, cp)) inside = false
    inside
}

class XsdRegexEmitter(
    val ops: array<int>,
    val a: array<int>,
    val b: array<int>,
    var tooBig: bool = false
) {
    fun add(op: int, first: int, second: int): int {
        if (ops.size >= xsdRegexMaxProgram) {
            tooBig = true
            return ops.size - 1
        }
        ops.append(op)
        a.append(first)
        b.append(second)
        ops.size - 1
    }

    fun emit(node: XsdRegexNode): void {
        if (tooBig) return
        when (node) {
            is XsdRegexChar -> add(OP_CHAR, node.cp, 0)
            is XsdRegexClass -> add(OP_CLASS, node.index, 0)
            is XsdRegexSequence -> for (item in node.items) emit(item)
            is XsdRegexChoice -> {
                val jumps: array<int> = []
                var i = 0
                while (i < node.options.size) {
                    if (i + 1 < node.options.size) {
                        val split = add(OP_SPLIT, 0, 0)
                        a[split] = ops.size
                        emit(node.options[i])
                        jumps.append(add(OP_JUMP, 0, 0))
                        b[split] = ops.size
                    } else {
                        emit(node.options[i])
                    }
                    i = i + 1
                }
                for (jump in jumps) a[jump] = ops.size
            }
            is XsdRegexRepeat -> {
                var i = 0
                while (i < node.min) {
                    emit(node.item)
                    i = i + 1
                }
                if (node.max < 0) {
                    val split = add(OP_SPLIT, 0, 0)
                    a[split] = ops.size
                    emit(node.item)
                    add(OP_JUMP, split, 0)
                    b[split] = ops.size
                } else {
                    val splits: array<int> = []
                    while (i < node.max) {
                        val split = add(OP_SPLIT, 0, 0)
                        splits.append(split)
                        a[split] = ops.size
                        emit(node.item)
                        i = i + 1
                    }
                    for (split in splits) b[split] = ops.size
                }
            }
        }
        return
    }
}

// Compiles an XSD pattern. A pattern that isn't one, or one this doesn't support,
// gives an XsdRegex whose `error` says so.
fun xsdRegexCompile(pattern: string): XsdRegex {
    val cps: array<int> = []
    if (xmlFirstInvalidChar(pattern) >= 0) return XsdRegex(pattern, [], [], [], [], "the pattern isn't valid UTF-8")
    var i = 0
    while (i < pattern.size) {
        cps.append(xmlCodePointAt(pattern, i))
        i = i + xmlUtf8Size(pattern[i])
    }
    val parser = XsdRegexParser(cps, 0, [])
    val tree = parser.regExp()
    if (parser.error == "" && parser.pos < cps.size) parser.fail("unexpected )")
    if (parser.error != "") return XsdRegex(pattern, [], [], [], [], parser.error)
    val emitter = XsdRegexEmitter([], [], [])
    emitter.emit(tree)
    emitter.add(OP_MATCH, 0, 0)
    if (emitter.tooBig) return XsdRegex(pattern, [], [], [], [], "the pattern compiles to more than $xsdRegexMaxProgram instructions")
    XsdRegex(pattern, emitter.ops, emitter.a, emitter.b, parser.classes, "")
}

// Adds `pc` and what it reaches without reading, to `list`, once per step.
private fun xsdRegexAdd(regex: XsdRegex, var list: array<int>, var marks: array<int>, generation: int, var stack: array<int>, pc: int): void {
    stack.clear()
    stack.append(pc)
    while (stack.size > 0) {
        val at = stack[stack.size - 1]
        stack.truncate(stack.size - 1)
        if (marks[at] == generation) continue
        marks[at] = generation
        val op = regex.ops[at]
        if (op == OP_JUMP) {
            stack.append(regex.a[at])
        } else if (op == OP_SPLIT) {
            stack.append(regex.b[at])
            stack.append(regex.a[at])
        } else {
            list.append(at)
        }
    }
    return
}

// Whether the whole of `text` matches. Text must be valid UTF-8.
fun xsdRegexMatches(regex: XsdRegex, text: string): bool {
    if (regex.error != "") return false
    val size = regex.ops.size
    val marks = filledArray(size, -1)
    val lists: array<array<int>> = [[], []]
    var cur = 0
    val stack: array<int> = []
    var generation = 0
    xsdRegexAdd(regex, lists[0], marks, generation, stack, 0)
    var offset = 0
    while (offset < text.size) {
        if (lists[cur].size == 0) return false
        val cp = xmlCodePointAt(text, offset)
        offset = offset + xmlUtf8Size(text[offset])
        generation = generation + 1
        val other = 1 - cur
        lists[other].clear()
        for (pc in lists[cur]) {
            val op = regex.ops[pc]
            var takes = false
            if (op == OP_CHAR) takes = regex.a[pc] == cp
            else if (op == OP_CLASS) takes = xsdClassContains(regex.classes, regex.a[pc], cp)
            if (takes) xsdRegexAdd(regex, lists[other], marks, generation, stack, pc + 1)
        }
        cur = other
    }
    for (pc in lists[cur]) if (regex.ops[pc] == OP_MATCH) return true
    false
}
