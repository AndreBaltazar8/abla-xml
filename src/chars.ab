// Character classes of XML 1.0 (Fifth Edition) and Namespaces in XML 1.0.
import "abla/text"

val xmlNamespaceXml = "http://www.w3.org/XML/1998/namespace"
val xmlNamespaceXmlns = "http://www.w3.org/2000/xmlns/"

// [2] Char
fun xmlIsChar(cp: int): bool =
    (cp >= 32 && cp <= 55295) || cp == 9 || cp == 10 || cp == 13 ||
    (cp >= 57344 && cp <= 65533) || (cp >= 65536 && cp <= 1114111)

// [3] S, on one byte
fun xmlIsSpace(byte: int): bool =
    byte == 32 || byte == 10 || byte == 9 || byte == 13

// [4] NameStartChar
fun xmlIsNameStart(cp: int): bool {
    if (cp < 128) {
        return (cp >= 97 && cp <= 122) || (cp >= 65 && cp <= 90) ||
            cp == 95 || cp == 58
    }
    (cp >= 0xC0 && cp <= 0xD6) || (cp >= 0xD8 && cp <= 0xF6) ||
    (cp >= 0xF8 && cp <= 0x2FF) || (cp >= 0x370 && cp <= 0x37D) ||
    (cp >= 0x37F && cp <= 0x1FFF) || (cp >= 0x200C && cp <= 0x200D) ||
    (cp >= 0x2070 && cp <= 0x218F) || (cp >= 0x2C00 && cp <= 0x2FEF) ||
    (cp >= 0x3001 && cp <= 0xD7FF) || (cp >= 0xF900 && cp <= 0xFDCF) ||
    (cp >= 0xFDF0 && cp <= 0xFFFD) || (cp >= 0x10000 && cp <= 0xEFFFF)
}

// [4a] NameChar
fun xmlIsNameChar(cp: int): bool {
    if (cp < 128) {
        return (cp >= 97 && cp <= 122) || (cp >= 65 && cp <= 90) ||
            (cp >= 48 && cp <= 57) || cp == 95 || cp == 58 || cp == 45 ||
            cp == 46
    }
    cp == 0xB7 || xmlIsNameStart(cp) || (cp >= 0x300 && cp <= 0x36F) ||
    (cp >= 0x203F && cp <= 0x2040)
}

// The byte length of the sequence a valid UTF-8 lead byte starts.
fun xmlUtf8Size(lead: int): int =
    if (lead < 0x80) 1 else if (lead < 0xE0) 2 else if (lead < 0xF0) 3 else 4

// The code point at a boundary of text already known to be valid UTF-8.
fun xmlCodePointAt(text: string, offset: int): int {
    val lead = text[offset]
    if (lead < 0x80) return lead
    if (lead < 0xE0) return ((lead & 0x1F) << 6) | (text[offset + 1] & 0x3F)
    if (lead < 0xF0) {
        return ((lead & 0x0F) << 12) | ((text[offset + 1] & 0x3F) << 6) |
            (text[offset + 2] & 0x3F)
    }
    ((lead & 0x07) << 18) | ((text[offset + 1] & 0x3F) << 12) |
        ((text[offset + 2] & 0x3F) << 6) | (text[offset + 3] & 0x3F)
}

// The offset of the first byte that isn't part of valid UTF-8 encoding an XML
// Char, or -1 when every character is allowed.
fun xmlFirstInvalidChar(text: string): int {
    val size = text.size
    var i = 0
    while (i < size) {
        val b = text[i]
        if (b < 0x80) {
            if (b < 32 && b != 10 && b != 9 && b != 13) return i
            i = i + 1
        } else if (b < 0xC2) {
            return i
        } else if (b < 0xE0) {
            if (i + 1 >= size || (text[i + 1] & 0xC0) != 0x80) return i
            i = i + 2
        } else if (b < 0xF0) {
            if (i + 2 >= size) return i
            val b1 = text[i + 1]
            val b2 = text[i + 2]
            if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80) return i
            if (b == 0xE0 && b1 < 0xA0) return i
            // Surrogates, and U+FFFE and U+FFFF.
            if (b == 0xED && b1 >= 0xA0) return i
            if (b == 0xEF && b1 == 0xBF && b2 >= 0xBE) return i
            i = i + 3
        } else if (b < 0xF5) {
            if (i + 3 >= size) return i
            val b1 = text[i + 1]
            if ((b1 & 0xC0) != 0x80 || (text[i + 2] & 0xC0) != 0x80 ||
                (text[i + 3] & 0xC0) != 0x80) return i
            if (b == 0xF0 && b1 < 0x90) return i
            if (b == 0xF4 && b1 >= 0x90) return i
            i = i + 4
        } else {
            return i
        }
    }
    -1
}

// [5] Name. The text must be valid UTF-8; invalid text is not a name.
fun xmlIsName(text: string): bool {
    if (text.size == 0 || xmlFirstInvalidChar(text) >= 0) return false
    val first = xmlCodePointAt(text, 0)
    if (!xmlIsNameStart(first)) return false
    var i = xmlUtf8Size(text[0])
    while (i < text.size) {
        if (!xmlIsNameChar(xmlCodePointAt(text, i))) return false
        i = i + xmlUtf8Size(text[i])
    }
    true
}

// [4] NCName of Namespaces in XML: a Name without a colon.
fun xmlIsNcName(text: string): bool = xmlIsName(text) && text.indexOf(":") < 0

// [7] QName of Namespaces in XML: an NCName, or two joined by one colon.
fun xmlIsQName(text: string): bool {
    if (!xmlIsName(text)) return false
    val colon = text.indexOf(":")
    if (colon < 0) return true
    if (colon == 0 || colon == text.size - 1) return false
    if (text.indexOf(":", colon + 1) >= 0) return false
    xmlIsNameStart(xmlCodePointAt(text, colon + 1))
}

fun xmlPrefixOf(qname: string): string {
    val colon = qname.indexOf(":")
    if (colon < 0) "" else qname.slice(0, colon)
}

fun xmlLocalOf(qname: string): string {
    val colon = qname.indexOf(":")
    if (colon < 0) qname else qname.slice(colon + 1, qname.size)
}

// Why a namespace declaration is forbidden (Namespaces in XML section 3), or ""
// when it is allowed. The empty prefix declares the default namespace.
fun xmlNamespaceDeclarationError(prefix: string, uri: string): string {
    if (prefix == "xmlns") return "reserved_namespace_prefix"
    if (prefix == "xml") {
        return if (uri == xmlNamespaceXml) "" else "reserved_namespace_prefix"
    }
    if (uri == xmlNamespaceXml || uri == xmlNamespaceXmlns) {
        return "reserved_namespace_uri"
    }
    if (prefix.size > 0 && uri.size == 0) return "empty_namespace_prefix"
    ""
}

// Whether any key occurs twice.
fun xmlHasDuplicate(keys: array<string>): bool {
    if (keys.size <= 8) {
        var i = 1
        while (i < keys.size) {
            var j = 0
            while (j < i) {
                if (keys[i] == keys[j]) return true
                j = j + 1
            }
            i = i + 1
        }
        return false
    }
    val seen: Map<string, bool> = Map()
    for (key in keys) {
        if (seen.has(key)) return true
        seen.set(key, true)
    }
    false
}
