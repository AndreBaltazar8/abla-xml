// Existing package import path for the shared XML value family.
export import "abla/xml"
import "writer.ab"

fun xmlWriteNode(var writer: XmlWriter, node: XmlNode): void {
    when (node) {
        is XmlText -> {
            if (node.cdata) writer.cdata(node.text) else writer.text(node.text)
        }
        is XmlComment -> writer.comment(node.text)
        is XmlProcessingInstruction -> writer.processingInstruction(node.target, node.data)
        is XmlSkippedEntity -> writer.fail("skipped_entity", "the tree lacks entity ${node.name}")
        is XmlElement -> xmlWriteElement(writer, node)
    }
    return
}

// Restore bindings inherited at the element's original location. A binding
// already declared on this tag cannot be changed without changing its meaning.
fun xmlCloseTreePrefix(var writer: XmlWriter, prefix: string, uri: string): void {
    if (writer.failed() || writer.prefixUri(prefix) == uri) return
    val binding = writer.findPrefix(prefix)
    if (binding >= writer.nsMarks[writer.nsMarks.size - 1] || prefix == "xml") {
        writer.fail("namespace_conflict", "conflicting namespace for prefix '$prefix'")
    } else {
        writer.namespace(prefix, uri)
    }
    return
}

// A resolved tree can only preserve the meaning of a node with known bindings.
fun xmlWriteResolvedNode(var writer: XmlWriter, node: XmlNode): void {
    when (node) {
        is XmlElement -> {
            if (!node.namespacesResolved) {
                writer.fail("unresolved_namespace", "XML literal needs a namespace-aware node")
                return
            }
        }
        else -> {}
    }
    xmlWriteNode(writer, node)
    return
}

// Writes the start of an element: its tag, attributes and namespace declarations, and the checks of a resolved tree. The children come after, in xmlWriteElement.
fun xmlWriteElementStart(var writer: XmlWriter, element: XmlElement): void {
    writer.startElement(element.name)
    for (attribute in element.attributes) {
        if (attribute.name == "xmlns") {
            writer.namespace("", attribute.value)
        } else if (attribute.prefix == "xmlns") {
            writer.namespace(attribute.localName, attribute.value)
        } else {
            writer.attribute(attribute.name, attribute.value)
        }
    }
    if (element.namespacesResolved && !writer.failed()) {
        val prefix = xmlPrefixOf(element.name)
        xmlCloseTreePrefix(writer, prefix, element.namespaceUri)
        for (attribute in element.attributes) {
            val attributePrefix = xmlPrefixOf(attribute.name)
            if (attributePrefix != "" && attributePrefix != "xmlns") {
                xmlCloseTreePrefix(writer, attributePrefix, attribute.namespaceUri)
            }
        }
        // A later attribute can introduce a binding that an earlier name
        // inherited. Check all expanded names against the completed tag.
        if (writer.prefixUri(prefix) != element.namespaceUri) {
            writer.fail("namespace_conflict", "conflicting namespace for ${element.name}")
        }
        for (attribute in element.attributes) {
            val attributePrefix = xmlPrefixOf(attribute.name)
            if (attribute.name != "xmlns" && attributePrefix != "xmlns") {
                val uri = if (attributePrefix == "") "" else writer.prefixUri(attributePrefix)
                if (uri != attribute.namespaceUri) {
                    writer.fail("namespace_conflict", "conflicting namespace for ${attribute.name}")
                }
            }
        }
    }
    return
}

// Writes an element and everything in it, in order. The tree is walked with a stack of its own, so how deep it is does not matter (a reader with its maxDepth raised
// can give a tree a million levels deep): the call stack does not grow with it.
fun xmlWriteElement(var writer: XmlWriter, element: XmlElement): void {
    val open: array<XmlElement> = [element]
    val next: array<int> = [0]
    xmlWriteElementStart(writer, element)
    while (open.size > 0) {
        val top = open.size - 1
        val current = open[top]
        val at = next[top]
        if (at >= current.children.size) {
            writer.endElement()
            open.truncate(top)
            next.truncate(top)
            continue
        }
        next[top] = at + 1
        val node = current.children[at]
        when (node) {
            is XmlElement -> {
                if (current.namespacesResolved && !node.namespacesResolved) {
                    writer.fail("unresolved_namespace", "XML literal needs a namespace-aware node")
                } else {
                    xmlWriteElementStart(writer, node)
                    open.append(node)
                    next.append(0)
                }
            }
            else -> xmlWriteNode(writer, node)
        }
    }
    return
}

// Writes a document in UTF-8 or the writer's encoding. A DTD is not written
// back; the attribute defaults it supplied are written as plain attributes, and
// its entities have been replaced already.
fun xmlWriteDocument(var writer: XmlWriter, document: XmlDocument): void {
    writer.declaration(document.standalone)
    for (node in document.prolog) xmlWriteNode(writer, node)
    xmlWriteElement(writer, document.root)
    for (node in document.epilog) xmlWriteNode(writer, node)
    return
}
