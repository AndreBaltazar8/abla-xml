// The document tree xmlParse builds and xmlWriteElement writes back.
import "abla/bytes"
import "writer.ab"
import "chars.ab"

// Matches an element or attribute in any namespace.
val xmlAnyNamespace = "*"

class XmlAttribute(
    val name: string,
    val prefix: string,
    val localName: string,
    val namespaceUri: string,
    val value: string,
    // False for a default the DTD supplied.
    val specified: bool = true
)

sealed interface XmlNode

class XmlText(val text: string, val cdata: bool = false) : XmlNode
class XmlComment(val text: string) : XmlNode
class XmlProcessingInstruction(val target: string, val data: string) : XmlNode
// A reference to an entity the parser didn't read: an external one, or one
// declared somewhere it didn't read. Its content is unknown.
class XmlSkippedEntity(val name: string) : XmlNode

class XmlElement(
    val name: string,
    val prefix: string,
    val localName: string,
    val namespaceUri: string,
    val attributes: array<XmlAttribute>,
    val children: array<XmlNode>,
    val byteOffset: int,
    val line: int,
    val column: int
) : XmlNode {
    // The attribute with this local name, or null.
    fun attribute(localName: string, namespaceUri: string = ""): XmlAttribute? {
        for (candidate in attributes) {
            if (candidate.localName == localName &&
                xmlNamespaceMatches(candidate.namespaceUri, namespaceUri) &&
                candidate.namespaceUri != xmlNamespaceXmlns) return candidate
        }
        null
    }

    // That attribute's value, or `fallback`.
    fun attributeValue(localName: string, fallback: string = "", namespaceUri: string = ""): string {
        val found = attribute(localName, namespaceUri)
        if (found != null) found.value else fallback
    }

    // The first child element with this local name, or null. Without a
    // namespace argument any namespace matches.
    fun child(localName: string, namespaceUri: string = xmlAnyNamespace): XmlElement? {
        for (node in children) {
            when (node) {
                is XmlElement -> {
                    if (node.localName == localName &&
                        xmlNamespaceMatches(node.namespaceUri, namespaceUri)) return node
                }
                else -> {}
            }
        }
        null
    }

    // Every child element, or those with this local name.
    fun elements(localName: string = xmlAnyNamespace, namespaceUri: string = xmlAnyNamespace): array<XmlElement> {
        val found: array<XmlElement> = []
        for (node in children) {
            when (node) {
                is XmlElement -> {
                    if ((localName == xmlAnyNamespace || node.localName == localName) &&
                        xmlNamespaceMatches(node.namespaceUri, namespaceUri)) found.append(node)
                }
                else -> {}
            }
        }
        found
    }

    // All the text in this element and below it, in document order.
    fun text(): string {
        val out = byteBuffer()
        xmlAppendText(out, this)
        out.toText()
    }

    // The text of the first child with this local name, or "".
    fun childText(localName: string, namespaceUri: string = xmlAnyNamespace): string {
        val found = child(localName, namespaceUri)
        if (found != null) found.text() else ""
    }
}

class XmlDoctype(val name: string, val publicId: string, val systemId: string)

class XmlDocument(
    val version: string,
    // As declared; "" when the declaration has none.
    val encoding: string,
    val standalone: string,
    val doctype: XmlDoctype?,
    // Comments and processing instructions before the root element.
    val prolog: array<XmlNode>,
    val root: XmlElement,
    // And after it.
    val epilog: array<XmlNode>,
    // Whether the content is incomplete: some entity wasn't read.
    val skippedEntities: int
)

fun xmlNamespaceMatches(actual: string, wanted: string): bool =
    wanted == xmlAnyNamespace || actual == wanted

fun xmlAppendText(var out: ByteBuffer, element: XmlElement): void {
    for (node in element.children) {
        when (node) {
            is XmlText -> out.appendText(node.text)
            is XmlElement -> xmlAppendText(out, node)
            else -> {}
        }
    }
    return
}

fun xmlWriteNode(var writer: XmlWriter, node: XmlNode): void {
    when (node) {
        is XmlText -> {
            if (node.cdata) writer.cdata(node.text) else writer.text(node.text)
        }
        is XmlComment -> writer.comment(node.text)
        is XmlProcessingInstruction -> writer.processingInstruction(node.target, node.data)
        is XmlSkippedEntity -> writer.fail("skipped_entity", "the tree lacks entity ${node.name}")
        is XmlElement -> xmlWriteElement(writer, node)
    }
    return
}

// Writes an element and everything in it, in order.
fun xmlWriteElement(var writer: XmlWriter, element: XmlElement): void {
    writer.startElement(element.name)
    for (attribute in element.attributes) {
        if (attribute.name == "xmlns") {
            writer.namespace("", attribute.value)
        } else if (attribute.prefix == "xmlns") {
            writer.namespace(attribute.localName, attribute.value)
        } else {
            writer.attribute(attribute.name, attribute.value)
        }
    }
    for (node in element.children) xmlWriteNode(writer, node)
    writer.endElement()
    return
}

// Writes a document in UTF-8 or the writer's encoding. A DTD is not written
// back; the attribute defaults it supplied are written as plain attributes, and
// its entities have been replaced already.
fun xmlWriteDocument(var writer: XmlWriter, document: XmlDocument): void {
    writer.declaration(document.standalone)
    for (node in document.prolog) xmlWriteNode(writer, node)
    xmlWriteElement(writer, document.root)
    for (node in document.epilog) xmlWriteNode(writer, node)
    return
}
